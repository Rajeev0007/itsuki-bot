# ─────────────────────────────────────────────
#  Itsuki Bot — Environment Variables
#  Copy this file to .env and fill in the values
#  cp .env.example .env
# ─────────────────────────────────────────────

# ── Required ──────────────────────────────────
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Your bot's Application / Client ID
DISCORD_CLIENT_ID=your_client_id_here

# ── Optional ──────────────────────────────────
# A specific Guild (server) ID for instant command registration during development.
# Leave blank to register commands globally (takes up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs that have owner-level access
BOT_OWNERS=

# Prefix for message-based (prefix) commands. Defaults to ! if not set.
PREFIX=!

# ── Game lookups (all optional) ───────────────
# The gaming commands work WITHOUT any of these. Only the player-stats
# subcommands need a key; everything else uses keyless public APIs.
#
# Needed by: /cs2 stats
#   Free from https://steamcommunity.com/dev/apikey
#   (/cs2 weapon, /cs2 weapons and /cs2 maps work without it)
STEAM_API_KEY=

# Needed by: /valorant player
#   Free from https://docs.henrikdev.xyz
#   (/valorant agent, weapon, map and agents work without it)
HENRIKDEV_API_KEY=

# No key needed for any /minecraft command — Mojang and mcsrvstat.us are public.

# ── Vote webhooks (optional) ──────────────────
# The vote notifier, vote-lock and reminders only activate for providers whose
# secret is set here. A provider WITHOUT a secret is disabled rather than left
# open — otherwise anyone could POST forged votes to your bot.
#
# 1. Pick any long random string as the secret (this is yours to invent).
# 2. Paste the SAME string into the site's webhook settings.
# 3. Point the site's webhook URL at your host:
#      Top.gg → http://<your-host>:3001/vote/topgg
#      DBL    → http://<your-host>:3001/vote/dbl
#    Put this behind a reverse proxy with HTTPS in production.
# 4. Run /voteconfig status in Discord to confirm it's live.
TOPGG_WEBHOOK_AUTH=
DBL_WEBHOOK_AUTH=

# Port the webhook receiver listens on. Defaults to 3001.
VOTE_SERVER_PORT=3001
