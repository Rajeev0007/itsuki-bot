# ─────────────────────────────────────────────
#  Itsuki Bot — Environment Variables
#  Copy this file to .env and fill in the values
#  cp .env.example .env
# ─────────────────────────────────────────────

# ── Required ──────────────────────────────────
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Your bot's Application / Client ID
DISCORD_CLIENT_ID=your_client_id_here

# ── Optional ──────────────────────────────────
# A specific Guild (server) ID for instant command registration during development.
# Leave blank to register commands globally (takes up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs that have owner-level access
BOT_OWNERS=

# Prefix for message-based (prefix) commands. Defaults to ! if not set.
PREFIX=!

# ── Game lookups (all optional) ───────────────
# The gaming commands work WITHOUT any of these. Only the player-stats
# subcommands need a key; everything else uses keyless public APIs.
#
# Needed by: /cs2 stats
#   Free from https://steamcommunity.com/dev/apikey
#   (/cs2 weapon, /cs2 weapons and /cs2 maps work without it)
STEAM_API_KEY=

# Needed by: /valorant player
#   Free from https://docs.henrikdev.xyz
#   (/valorant agent, weapon, map and agents work without it)
HENRIKDEV_API_KEY=

# No key needed for any /minecraft command — Mojang and mcsrvstat.us are public.

# ── Vote webhooks (optional) ──────────────────
# The vote notifier, vote-lock and reminders only activate for providers whose
# secret is set here. A provider WITHOUT a secret is disabled rather than left
# open — otherwise anyone could POST forged votes to your bot.
#
# 1. Pick any long random string as the secret (this is yours to invent).
# 2. Paste the SAME string into the site's webhook settings.
# 3. Point the site's webhook URL at your host:
#      Top.gg → http://<your-host>:3001/vote/topgg
#      DBL    → http://<your-host>:3001/vote/dbl
#    Put this behind a reverse proxy with HTTPS in production.
# 4. Run /voteconfig status in Discord to confirm it's live.
TOPGG_WEBHOOK_AUTH=
DBL_WEBHOOK_AUTH=

# Port the webhook receiver listens on. Defaults to 3001.
VOTE_SERVER_PORT=3001

# Set to true ONLY when the webhook receiver sits behind a reverse proxy you
# control (nginx, Caddy, Cloudflare), as recommended above.
#
# The per-IP rate limiter keys on the socket address, which behind a proxy is the
# PROXY's address — so every delivery from both sites shares one 60-requests-per
# -minute bucket and genuine votes start getting 429'd. With this enabled the
# limiter reads X-Forwarded-For instead. Leave it unset when the port is exposed
# directly: that header is client-supplied, so trusting it without a proxy in
# front lets anyone forge a fresh bucket per request and bypass the limit.
TRUST_PROXY=false

# ── Database (required) ───────────────────────────────────────────────────────
# The bot stores everything in MongoDB. It refuses to start without this rather
# than silently writing somewhere you are not looking.
#   Local:  mongodb://127.0.0.1:27017/itsuki
#   Atlas:  mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/itsuki
MONGO_URI=
# Only used when the URI does not already name a database.
MONGO_DB=itsuki
# How long to wait for a reachable server before failing (ms).
MONGO_TIMEOUT_MS=8000

# ── Installation contexts ─────────────────────────────────────────────────────
# Register commands for account-level installs ("Add to my apps") as well as
# server installs. Leave unset/true unless you specifically do not want that.
#
# This ALSO has to be enabled in the Developer Portal:
#   Developer Portal -> your app -> Installation -> Installation Contexts
#   -> tick "User Install"
# If it is not enabled, Discord rejects the registration and the bot retries with
# server install only, logging exactly what to change.
USER_INSTALL=true


# ── Public links (all optional) ───────────────────────────────────────────────
# Shown as buttons on /stats. Anything left blank is simply not rendered — a
# Discord link button with a malformed URL is rejected by the API and would take
# the whole message down with it, so these are validated before use.
#
# INVITE_URL: prefer the install link from the Developer Portal
# (Installation → Install Link), since that is where the requested permission set
# lives. Left blank, the bot builds a scope-only invite with NO permissions
# parameter, so Discord applies the app's configured default rather than the code
# asserting a bitfield of its own.
INVITE_URL=
SUPPORT_SERVER_URL=
WEBSITE_URL=
GITHUB_URL=
# Discord requires these two for verified bots. Linking them here also puts them
# one click away for users, which is what the review process looks for.
PRIVACY_POLICY_URL=
TERMS_URL=
