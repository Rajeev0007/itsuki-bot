# Some hosts (Pterodactyl-style Node eggs, for example) run a bare
# `npm install` from a startup script that cannot be given flags, so install
# configuration has to live in the repo instead.
#
# Every peer dependency in this tree is a peerOptional voice codec or helper:
# opusscript, @discordjs/opus, node-opus, ffmpeg-static, tweetnacl and the
# sodium variants, declared by prism-media and @discordjs/voice. npm 7+ turns a
# version mismatch on any of those into a hard ERESOLVE failure even though the
# package is optional and the version we pin is deliberate — which stops the
# whole install rather than just skipping an optional codec.
#
# The versions in package.json are already chosen to satisfy those ranges, so
# this is a safety net rather than the fix: it keeps an unparameterised
# `npm install` from failing outright if a future dependency bump introduces a
# new optional-peer mismatch.
legacy-peer-deps=true
